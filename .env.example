# Salin file ini menjadi .env.local dan ganti seluruh dummy value.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Better Auth
BETTER_AUTH_SECRET=dummy-change-me-minimum-32-characters-long
BETTER_AUTH_URL=http://localhost:3000

# Google OAuth
# Callback URL: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=dummy-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=dummy-google-client-secret

# Cloudflare Turnstile
# Site key boleh diteruskan ke browser; secret key wajib server-only.
TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
TURNSTILE_EXPECTED_HOSTNAME=localhost

# Contoh integrasi opsional
DATABASE_URL=postgresql://dummy:dummy@localhost:5432/ganipedia
